# ===================================================
# Omen — Environment Configuration Template
# Duplicate this file as '.env' and fill in your values
# ===================================================

# Main Application Port
PORT=3000

# WhatsApp Gateway (WPPConnect Server)
WPP_HOST=http://localhost
WPP_PORT=21465
WPP_SESSION_NAME=leads-hunter
WPP_SECRET_KEY=your_secure_wpp_secret_key_here

# Google Sheets Webhook Integration (Optional)
# Follow instructions in settings to deploy your Google Apps Script webhook
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_URL=
